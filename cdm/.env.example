# ===== CDM BASE CONFIG =====
CDM_PORT=3000
CDM_ENV=development
CDM_LOG_LEVEL=info

# ===== GOOGLE APPS SCRIPT =====
# Replace with the deployed Web App URL/ID
APPSCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
APPSCRIPT_TIMEOUT_MS=30000

# ===== CACHE (Redis) =====
REDIS_URL=redis://localhost:6379
# If using password/user
# REDIS_PASSWORD=
# REDIS_USER=

# Cache TTLs (in seconds)
CACHE_TTL_READ_TRANSCRIPTIONS=300
CACHE_TTL_GET_TEXT=900
CACHE_TTL_UPDATE=0

# ===== RATE LIMITING =====
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_REQUESTS_PER_DAY=5000

# ===== SECURITY =====
JWT_SECRET=changeme_minimum_32_characters_secret
JWT_EXPIRATION=3600
API_KEY=sk_live_test_key

# ===== CORS =====
CORS_ORIGIN=https://mj-transcripciones-groq-test.vercel.app
